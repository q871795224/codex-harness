{
  "name": "codex-harness",
  "private": true,
  "version": "0.4.21",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort --mode stable",
    "dev:dev": "vite --host 127.0.0.1 --port 1421 --strictPort --mode dev",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build --target universal-apple-darwin",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "lucide-react": "^0.468.0",
    "postman-collection": "5.3.1",
    "postman-sandbox": "6.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "string_decoder": "1.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.11"
  }
}
