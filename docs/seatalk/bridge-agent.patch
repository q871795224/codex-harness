diff --git a/src/harness-remote.js b/src/harness-remote.js
new file mode 100644
index 0000000..8f9c293
--- /dev/null
+++ b/src/harness-remote.js
@@ -0,0 +1,132 @@
+import { createHash } from 'node:crypto';
+import { accountToAdapterConfig } from './db.js';
+
+// Bridge owns credentials and delivery receipts. Harness owns all agent execution.
+export class HarnessRemote {
+  constructor(gateway) {
+    this.gateway = gateway;
+    this.db = gateway.store.db;
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS harness_remote_bindings (
+        account_id TEXT NOT NULL, thread_id TEXT NOT NULL, root_id TEXT NOT NULL,
+        created_at INTEGER NOT NULL, PRIMARY KEY(account_id, thread_id), UNIQUE(account_id, root_id)
+      );
+      CREATE TABLE IF NOT EXISTS harness_remote_deliveries (
+        account_id TEXT NOT NULL, delivery_key TEXT NOT NULL, fingerprint TEXT NOT NULL,
+        status TEXT NOT NULL, native_id TEXT, PRIMARY KEY(account_id, delivery_key)
+      );
+      CREATE TABLE IF NOT EXISTS harness_remote_commands (
+        account_id TEXT NOT NULL, message_id TEXT NOT NULL, status TEXT NOT NULL,
+        PRIMARY KEY(account_id, message_id)
+      );
+    `);
+  }
+
+  account(name) {
+    const account = this.gateway.accounts.find(a => a.name === name);
+    if (!account || account.platform !== 'seatalk_openapi') throw new Error('Harness requires a SeaTalk OpenAPI account');
+    const config = accountToAdapterConfig(account);
+    if (config.runtime?.enabled !== false && config.runtime?.type === 'codex') throw new Error('This Bot already runs a separate Codex runtime');
+    const owner = config.notificationTargetEmployeeCode;
+    if (!owner || owner.startsWith('env:')) throw new Error('Harness Bot notification recipient is not configured');
+    return { ...account, owner };
+  }
+
+  async call(action, method, input) {
+    const account = this.account(input.account || 'harness-sessions');
+    const get = ['status', 'bindings', 'messages'].includes(action);
+    if (method !== (get ? 'GET' : 'POST')) throw new Error('Unsupported Harness remote method');
+    switch (action) {
+      case 'status': {
+        const channel = this.gateway.channels.get(account.name);
+        const status = await channel.status();
+        return { accountId: account.id, ownerId: account.owner, reachable: status.reachable === true,
+          connected: status.inbound?.connected === true, state: status.inbound?.state || 'not-configured' };
+      }
+      case 'bindings': return { bindings: this.bindings(account) };
+      case 'messages': return this.messages(account, input.after);
+      case 'send': return this.send(account, input);
+      case 'claim': return this.claim(account, input);
+      case 'finish': {
+        if (!['completed', 'failed'].includes(input.status)) throw new Error('Invalid command status');
+        this.db.prepare('UPDATE harness_remote_commands SET status=? WHERE account_id=? AND message_id=? AND status=\'claimed\'')
+          .run(input.status, account.id, input.messageId);
+        return { ok: true };
+      }
+      default: throw new Error('Unsupported Harness remote action');
+    }
+  }
+
+  bindings(account) {
+    return this.db.prepare('SELECT thread_id AS threadId, root_id AS rootId, created_at AS createdAt FROM harness_remote_bindings WHERE account_id=?').all(account.id);
+  }
+
+  messages(account, after = 0) {
+    const cursor = Number(after);
+    if (!Number.isSafeInteger(cursor) || cursor < 0) throw new Error('Invalid message cursor');
+    const rows = this.db.prepare(`SELECT rowid AS cursor, id, thread_id, raw_json, text FROM messages
+      WHERE account_id=? AND direction='inbound' AND rowid>? AND deleted_at IS NULL
+      AND NOT EXISTS (SELECT 1 FROM harness_remote_commands c WHERE c.account_id=messages.account_id AND c.message_id=messages.id)
+      ORDER BY rowid LIMIT 100`).all(account.id, cursor);
+    const roots = new Set(this.bindings(account).map(b => b.rootId));
+    const messages = rows.flatMap(row => {
+      const raw = row.raw_json ? JSON.parse(row.raw_json) : {};
+      const event = raw.event || {};
+      // Only the configured owner's actual subscriber DMs can control Harness.
+      if (raw.event_type !== 'message_from_bot_subscriber' || event.employee_code !== account.owner || !roots.has(row.thread_id)) return [];
+      return [{ id: row.id, cursor: row.cursor, rootId: row.thread_id, text: row.text || '' }];
+    });
+    return { messages, cursor: rows.at(-1)?.cursor ?? cursor, hasMore: rows.length === 100 };
+  }
+
+  claim(account, input) {
+    const row = this.db.prepare('SELECT thread_id, raw_json FROM messages WHERE account_id=? AND id=? AND direction=\'inbound\' AND deleted_at IS NULL')
+      .get(account.id, input.messageId);
+    const raw = row?.raw_json ? JSON.parse(row.raw_json) : {};
+    const binding = row && this.db.prepare('SELECT thread_id FROM harness_remote_bindings WHERE account_id=? AND root_id=?').get(account.id, row.thread_id);
+    if (!binding || raw.event_type !== 'message_from_bot_subscriber' || raw.event?.employee_code !== account.owner) throw new Error('Unauthorized Harness command');
+    const result = this.db.prepare('INSERT OR IGNORE INTO harness_remote_commands VALUES (?, ?, \'claimed\')').run(account.id, input.messageId);
+    return { claimed: result.changes === 1, threadId: binding.thread_id };
+  }
+
+  async send(account, input) {
+    const threadId = nonempty(input.threadId, 200);
+    let binding = this.db.prepare('SELECT root_id AS rootId, created_at AS createdAt FROM harness_remote_bindings WHERE account_id=? AND thread_id=?').get(account.id, threadId);
+    if (!binding) {
+      const root = await this.deliver(account, `root:${threadId}`, `${nonempty(input.title, 2000)}\n${nonempty(input.cwd, 3000)}\n\n在此分支回复即可继续会话。/状态 查看进度，/停止 停止执行。`, null, true);
+      const createdAt = Date.now();
+      this.db.prepare('INSERT OR IGNORE INTO harness_remote_bindings VALUES (?, ?, ?, ?)').run(account.id, threadId, root.messageId, createdAt);
+      binding = this.db.prepare('SELECT root_id AS rootId, created_at AS createdAt FROM harness_remote_bindings WHERE account_id=? AND thread_id=?').get(account.id, threadId);
+    }
+    if (input.eventId) await this.deliver(account, `event:${threadId}:${nonempty(input.eventId, 240)}`, nonempty(input.text, 19000), binding.rootId);
+    return binding;
+  }
+
+  async deliver(account, key, text, rootId, root = false) {
+    const fingerprint = createHash('sha256').update(root ? key : JSON.stringify([rootId, text])).digest('hex');
+    const previous = this.db.prepare('SELECT * FROM harness_remote_deliveries WHERE account_id=? AND delivery_key=?').get(account.id, key);
+    if (previous) {
+      if (previous.fingerprint !== fingerprint) throw new Error('Harness delivery key reused with different contents');
+      if (previous.status !== 'sent') throw new Error('Previous SeaTalk delivery is unresolved; it will not be resent automatically');
+      return { messageId: previous.native_id };
+    }
+    // Register before network IO: an ambiguous timeout must never duplicate a root or message.
+    this.db.prepare('INSERT INTO harness_remote_deliveries VALUES (?, ?, ?, \'pending\', NULL)').run(account.id, key, fingerprint);
+    try {
+      const result = await this.gateway.sendMessage({ account: account.name, target: { type: 'user', id: account.owner },
+        message: { type: 'text', text }, ...(rootId ? { threadId: rootId } : {}) });
+      const nativeId = result.result?.message_id || result.result?.data?.message_id;
+      if (!result.ok || !nativeId) throw new Error('SeaTalk did not return a native message receipt');
+      this.db.prepare('UPDATE harness_remote_deliveries SET status=\'sent\', native_id=? WHERE account_id=? AND delivery_key=?').run(nativeId, account.id, key);
+      return { messageId: nativeId };
+    } catch {
+      this.db.prepare('UPDATE harness_remote_deliveries SET status=\'unknown\' WHERE account_id=? AND delivery_key=?').run(account.id, key);
+      throw new Error('SeaTalk delivery could not be confirmed; check Bridge before retrying');
+    }
+  }
+}
+
+function nonempty(value, max) {
+  if (typeof value !== 'string' || !value.trim() || Buffer.byteLength(value) > max) throw new Error('Invalid Harness remote input');
+  return value;
+}
diff --git a/test/harness-remote.test.js b/test/harness-remote.test.js
new file mode 100644
index 0000000..335b328
--- /dev/null
+++ b/test/harness-remote.test.js
@@ -0,0 +1,76 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { openBridgeStore } from '../src/db.js';
+import { HarnessRemote } from '../src/harness-remote.js';
+import { BridgeGateway } from '../src/gateway.js';
+
+function setup() {
+  const store = openBridgeStore(':memory:');
+  const account = store.upsertAccount({ name: 'harness-sessions', platform: 'seatalk_openapi', config: { notificationTargetEmployeeCode: 'owner', inbound: { type: 'websocket' } } });
+  const sends = [];
+  const gateway = { store, accounts: [account], channels: new Map([['harness-sessions', { status: async () => ({ reachable: true, inbound: { connected: true } }) }]]),
+    sendMessage: async input => { sends.push(input); return { ok: true, messageId: 'local-not-native', result: { message_id: `native-${sends.length}` } }; } };
+  const remote = new HarnessRemote(gateway);
+  const inbound = (sender, root, text = 'continue') => store.insertMessage({ accountId: account.id, platform: 'seatalk_openapi', direction: 'inbound', conversationType: 'dm', conversationId: sender,
+    threadId: root, text, status: 'received', raw: { event_type: 'message_from_bot_subscriber', event: { employee_code: sender } } });
+  return { store, account, sends, gateway, remote, inbound };
+}
+
+test('one native SeaTalk root per session survives a restart and sends updates in its branch', async () => {
+  const { store, sends, gateway, remote } = setup();
+  const first = await remote.call('send', 'POST', { threadId: 'one', title: 'first', cwd: '/repo' });
+  assert.equal(first.rootId, 'native-1');
+  await new HarnessRemote(gateway).call('send', 'POST', { threadId: 'one', title: 'renamed', cwd: '/repo', eventId: 'reply', text: 'result' });
+  await remote.call('send', 'POST', { threadId: 'one', eventId: 'reply', text: 'result' });
+  await remote.call('send', 'POST', { threadId: 'two', title: 'second', cwd: '/repo' });
+  assert.equal(sends.length, 3);
+  assert.equal(sends[1].threadId, 'native-1');
+  assert.equal(sends[1].target.id, 'owner');
+  assert.equal(sends[2].threadId, undefined);
+  store.close();
+});
+
+test('unconfirmed sends are never automatically replayed or replaced by a local receipt', async () => {
+  const { store, gateway, remote } = setup(); let sent = 0;
+  gateway.sendMessage = async () => { sent++; return { ok: true, messageId: 'local-id', result: { code: 0 } }; };
+  await assert.rejects(remote.call('send', 'POST', { threadId: 'one', title: 'first', cwd: '/repo' }), /could not be confirmed/);
+  await assert.rejects(remote.call('send', 'POST', { threadId: 'one', title: 'first', cwd: '/repo' }), /unresolved/);
+  assert.equal(sent, 1); assert.equal(remote.bindings(remote.account('harness-sessions')).length, 0);
+  store.close();
+});
+
+test('cursor reads all pages and only the configured owner in known DM branches can claim', async () => {
+  const { store, remote, inbound } = setup();
+  await remote.call('send', 'POST', { threadId: 'one', title: 'first', cwd: '/repo' });
+  const unauthorized = inbound('stranger', 'native-1');
+  const unbound = inbound('owner', 'unbound');
+  const ids = Array.from({ length: 125 }, (_, i) => inbound('owner', 'native-1', `message-${i}`));
+  const first = await remote.call('messages', 'GET', {});
+  const second = await remote.call('messages', 'GET', { after: first.cursor });
+  assert.equal(first.hasMore, true); assert.equal(second.hasMore, false);
+  assert.deepEqual([...first.messages, ...second.messages].map(m => m.id), ids);
+  await assert.rejects(remote.call('claim', 'POST', { messageId: unauthorized }), /Unauthorized/);
+  await assert.rejects(remote.call('claim', 'POST', { messageId: unbound }), /Unauthorized/);
+  const a = await remote.call('claim', 'POST', { messageId: ids[0] });
+  const b = await remote.call('claim', 'POST', { messageId: ids[0] });
+  assert.deepEqual(a, { claimed: true, threadId: 'one' }); assert.equal(b.claimed, false);
+  await remote.call('finish', 'POST', { messageId: ids[0], status: 'completed' });
+  assert.equal((await remote.call('claim', 'POST', { messageId: ids[0] })).claimed, false);
+  store.close();
+});
+
+test('a Bot with its own enabled Codex runtime cannot also control Harness', async () => {
+  const { store, gateway, remote } = setup();
+  gateway.accounts[0].config.runtime = { type: 'codex', enabled: true };
+  await assert.rejects(remote.call('status', 'GET', {}), /separate Codex/);
+  store.close();
+});
+
+test('remote routes reject browser origins and non-loopback callers', async () => {
+  const { store } = setup(); const gateway = new BridgeGateway(store);
+  function res() { return { setHeader() {}, removeHeader() {}, writeHead(status) { this.status = status; }, end(body) { this.body = body; } }; }
+  const request = { method: 'GET', url: '/local/harness/status', headers: { host: '127.0.0.1:8787' }, socket: { remoteAddress: '192.0.2.1' } };
+  let response = res(); await gateway.handleRequest(request, response); assert.equal(response.status, 403);
+  response = res(); await gateway.handleRequest({ ...request, socket: { remoteAddress: '127.0.0.1' }, headers: { ...request.headers, origin: 'http://127.0.0.1:8787' } }, response); assert.equal(response.status, 403);
+  store.close();
+});
