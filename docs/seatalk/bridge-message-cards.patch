+
+test('Markdown results and actionable cards stay in the session branch; callbacks check owner, native card and durable claim', async () => {
+  const { store, account, remote, sends, gateway } = setup();
+  const token = '0123456789abcdef';
+  await remote.call('send', 'POST', { threadId: 'one', title: 'first', cwd: '/repo', eventId: 'result', text: '**done**', format: 'markdown' });
+  assert.equal(sends[1].message.type, 'markdown');
+  const input = { threadId: 'one', eventId: 'approval', text: 'ls', card: { title: 'Approval', buttons: [{ text: 'Accept', command: `/批准 ${token}` }] } };
+  await remote.call('send', 'POST', input);
+  assert.equal(sends[2].message.type, 'interactive');
+  assert.equal(sends[2].threadId, 'native-1');
+  const value = sends[2].message.buttons[0].value;
+  const interaction = (owner, id = 'native-3', buttonValue = value) => ({ accountId: account.id, conversationType: 'dm', messageId: id, value: buttonValue,
+    raw: { event_type: 'interactive_message_click', event: { employee_code: owner, message_id: id, value: buttonValue } } });
+  remote.receiveInteraction(interaction('stranger'));
+  remote.receiveInteraction(interaction('owner', 'wrong-card'));
+  remote.receiveInteraction(interaction('owner', 'native-3', 'harness:forged'));
+  assert.equal(remote.messages(remote.account('harness-sessions')).messages.length, 0);
+  const restart = new HarnessRemote(gateway);
+  await restart.call('send', 'POST', input);
+  assert.equal(sends.length, 3);
+  restart.receiveInteraction(interaction('owner'));
+  const messages = restart.messages(restart.account('harness-sessions')).messages;
+  assert.equal(messages.length, 1);
+  assert.equal(messages[0].text, `/批准 ${token}`);
+  assert.equal(messages[0].rootId, 'native-1');
+  assert.deepEqual(await restart.call('claim', 'POST', { messageId: messages[0].id }), { claimed: true, threadId: 'one' });
+  assert.equal((await remote.call('claim', 'POST', { messageId: messages[0].id })).claimed, false);
+  store.close();
+});
+
+test('the gateway persists a card callback once through the WebSocket interaction event path', async () => {
+  const { store, account } = setup();
+  const gateway = new BridgeGateway(store);
+  let count = 0;
+  const sent = [];
+  gateway.sendMessage = async input => { sent.push(input); return { ok: true, result: { message_id: `card-${++count}` } }; };
+  gateway.harnessRemote = new HarnessRemote(gateway);
+  await gateway.harnessRemote.call('send', 'POST', { threadId: 'one', title: 'one', cwd: '/repo', eventId: 'q', text: 'Question',
+    card: { title: 'Question', buttons: [{ text: 'Fast', command: '/选项 0123456789abcdef 0 0' }] } });
+  const value = sent[1].message.buttons[0].value;
+  const channel = gateway.channels.get('harness-sessions');
+  const payload = { event_id: 'callback-1', event_type: 'interactive_message_click', event: { employee_code: 'owner', message_id: 'card-2', value } };
+  channel.handleWebSocketEvent(payload);
+  channel.handleWebSocketEvent(payload);
+  const page = gateway.harnessRemote.messages(gateway.harnessRemote.account('harness-sessions'));
+  assert.equal(page.messages.length, 1);
+  assert.equal(page.messages[0].text, '/选项 0123456789abcdef 0 0');
+  assert.equal(page.messages[0].rootId, 'card-1');
+  store.close();
+});
